# One Bluestone organisation. Never commit real values.
# Copy this file to .env after you have TEST credentials.

MAPI_CLIENT_ID=
MAPI_CLIENT_SECRET=

# Optional. Published-catalog reads only (x-api-key). Writes still use MAPI.
# PAPI_KEY=

# test (default) or prod. Hosts follow auth.md in Bluestone Fluency.
# PIM_ENV=test

# Optional. Defaults to data/catalog.db and data/pim.db under the project root.
# CATALOG_DB_PATH=
# PIM_DB_PATH=

# Optional. Folder that contains Fluency SKILL.md (if it is not installed as a Cursor skill
# and not cloned next to this repo as ../bluestone-pim-ai-devkit or ../bluestone-pim-ai-devkit-public).
# BLUESTONE_FLUENCY_PATH=
